    function setSurgeEmptyState(message) {
      document.getElementById('simVelocityLabel').innerText = 'N/A';
      document.getElementById('simBaselineCoverage').innerText = message;
      document.getElementById('simUnitsNeededLabel').innerText = 'N/A';
      document.getElementById('simReorderLabel').innerText = 'Enter stock';
      document.getElementById('simCoverageLabel').innerText = 'Stock coverage unavailable';
      document.getElementById('simBudgetLabel').innerText = 'N/A';
      document.getElementById('simScenarioRows').innerHTML = `<tr><td colspan="4" class="p-3 text-center text-slate-400">${message}</td></tr>`;
      if (simForecastChartInstance) {
        simForecastChartInstance.destroy();
        simForecastChartInstance = null;
      }
      document.getElementById('simForecastChart').classList.add('hidden');
      document.getElementById('simForecastMessage').classList.remove('hidden');
      document.getElementById('simForecastMessage').textContent = message;
    }

    function renderSurgeForecast(dailyVelocity, surgePct, horizonDays, stockOnHand) {
      const canvas = document.getElementById('simForecastChart');
      const message = document.getElementById('simForecastMessage');
      canvas.classList.remove('hidden');
      message.classList.add('hidden');

      if (simForecastChartInstance) simForecastChartInstance.destroy();

      const labels = Array.from({ length: horizonDays }, (_, index) => `Day ${index + 1}`);
      const simulatedVelocity = dailyVelocity * (1 + surgePct);
      simForecastChartInstance = new Chart(canvas.getContext('2d'), {
        type: 'line',
        data: {
          labels,
          datasets: [
            {
              label: 'Projected cumulative demand',
              data: labels.map((_, index) => Number((simulatedVelocity * (index + 1)).toFixed(1))),
              borderColor: '#f59e0b',
              backgroundColor: 'rgba(245, 158, 11, 0.12)',
              fill: true,
              tension: 0.2,
              pointRadius: 0
            },
            {
              label: 'Stock on hand',
              data: stockOnHand === null ? labels.map(() => null) : labels.map(() => stockOnHand),
              borderColor: '#0b2545',
              borderDash: [5, 4],
              pointRadius: 0,
              fill: false
            }
          ]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          interaction: { intersect: false, mode: 'index' },
          scales: {
            x: { ticks: { autoSkip: true, maxTicksLimit: 8, maxRotation: 0 } },
            y: { beginAtZero: true, title: { display: true, text: 'Units' } }
          },
          plugins: {
            legend: { position: 'bottom', labels: { boxWidth: 10, font: { size: 9 } } },
            tooltip: { callbacks: { label: context => `${context.dataset.label}: ${context.raw ?? 'not entered'} units` } }
          }
        }
      });
    }

    function runSurgeSimulation() {
      const drugId = Number(document.getElementById('simDrugSelect').value);
      const surgePct = Number(document.getElementById('simSurgePct').value) / 100;
      const horizonDays = Number(document.getElementById('simHorizon').value);
      const baselineSelection = document.getElementById('simBaselineDays').value;
      const stockInput = document.getElementById('simStockOnHand').value.trim();
      const stockOnHand = stockInput === '' ? null : Math.max(0, Number(stockInput));

      if (!drugId) {
        setSurgeEmptyState('Select a medication to run the simulation.');
        return;
      }

      const datedMatches = prescriptions
        .filter(prescription => Number(prescription.drug_id) === drugId)
        .map(prescription => ({
          date: Date.parse(`${prescription.dim_date?.full_date || ''}T00:00:00Z`),
          units: Number(prescription.quantity_dispensed || 0),
          billed: Number(prescription.total_amount || 0)
        }))
        .filter(record => Number.isFinite(record.date));

      if (datedMatches.length === 0) {
        setSurgeEmptyState('No dated dispense history is available for this medication.');
        return;
      }

      const latestDate = datedMatches.reduce((latest, record) => Math.max(latest, record.date), -Infinity);
      const requestedDays = baselineSelection === 'all' ? Infinity : Number(baselineSelection);
      const cutoffDate = Number.isFinite(requestedDays)
        ? latestDate - (requestedDays - 1) * 24 * 60 * 60 * 1000
        : -Infinity;
      const baselineRecords = datedMatches.filter(record => record.date >= cutoffDate);
      const earliestBaselineDate = baselineRecords.reduce((earliest, record) => Math.min(earliest, record.date), Infinity);
      const baselineDays = Math.max(1, Math.ceil((latestDate - earliestBaselineDate) / (24 * 60 * 60 * 1000)) + 1);
      const totalUnits = baselineRecords.reduce((sum, record) => sum + record.units, 0);
      const totalBilled = baselineRecords.reduce((sum, record) => sum + record.billed, 0);
      const dailyVelocity = totalUnits / baselineDays;
      const simulatedVelocity = dailyVelocity * (1 + surgePct);
      const predictedTotalUnits = Math.ceil(simulatedVelocity * horizonDays);
      const billedValuePerUnit = totalUnits > 0 ? totalBilled / totalUnits : 0;
      const estimatedBilledValue = predictedTotalUnits * billedValuePerUnit;

      document.getElementById('simVelocityLabel').innerText = `${dailyVelocity.toFixed(2)} units/day`;
      document.getElementById('simBaselineCoverage').innerText = `Based on ${baselineDays} days of dated history`;
      document.getElementById('simUnitsNeededLabel').innerText = `${predictedTotalUnits.toLocaleString()} units`;
      document.getElementById('simBudgetLabel').innerText = `₱${estimatedBilledValue.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;

      if (stockOnHand === null || !Number.isFinite(stockOnHand)) {
        document.getElementById('simReorderLabel').innerText = 'Enter stock';
        document.getElementById('simCoverageLabel').innerText = 'Add current stock to estimate coverage';
      } else {
        const additionalUnits = Math.max(0, Math.ceil(predictedTotalUnits - stockOnHand));
        const coverageDays = simulatedVelocity > 0 ? stockOnHand / simulatedVelocity : Infinity;
        document.getElementById('simReorderLabel').innerText = `${additionalUnits.toLocaleString()} units`;
        document.getElementById('simCoverageLabel').innerText = Number.isFinite(coverageDays)
          ? `Stock lasts about ${coverageDays.toFixed(1)} days`
          : 'No projected demand';
      }

      const scenarios = [];
      const addScenario = (rate, label) => {
        if (!scenarios.some(scenario => scenario.rate === rate)) scenarios.push({ rate, label });
      };
      addScenario(0, 'Normal (0%)');
      addScenario(surgePct, `Selected (+${Math.round(surgePct * 100)}%)`);
      addScenario(1, 'High (+100%)');

      document.getElementById('simScenarioRows').innerHTML = scenarios.map(scenario => {
        const scenarioUnits = Math.ceil(dailyVelocity * (1 + scenario.rate) * horizonDays);
        const additionalUnits = stockOnHand === null ? 'Enter stock' : `${Math.max(0, Math.ceil(scenarioUnits - stockOnHand)).toLocaleString()} units`;
        const scenarioValue = scenarioUnits * billedValuePerUnit;
        return `
          <tr class="border-t border-slate-100">
            <td class="p-2 font-semibold text-slate-700">${scenario.label}</td>
            <td class="p-2 text-right">${scenarioUnits.toLocaleString()} units</td>
            <td class="p-2 text-right">${additionalUnits}</td>
            <td class="p-2 text-right">₱${scenarioValue.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 })}</td>
          </tr>
        `;
      }).join('');

      renderSurgeForecast(dailyVelocity, surgePct, horizonDays, stockOnHand);
    }

