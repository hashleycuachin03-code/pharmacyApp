    // 8. Tab Switcher
    function switchTab(tab) {
      ['analytics', 'prescriptions', 'drugs', 'patients', 'prescribers'].forEach(t => {
        document.getElementById(`tab-${t}`).classList.add('hidden');
        document.getElementById(`btn-tab-${t}`).classList.remove('bg-amber-500', 'text-slate-900', 'font-bold');
        document.getElementById(`btn-tab-${t}`).classList.add('text-slate-300');
      });

      document.getElementById(`tab-${tab}`).classList.remove('hidden');
      const activeBtn = document.getElementById(`btn-tab-${tab}`);
      activeBtn.classList.remove('text-slate-300');
      activeBtn.classList.add('bg-amber-500', 'text-slate-900', 'font-bold');

      if (tab === 'analytics') {
        renderAnalytics();
      }
    }
