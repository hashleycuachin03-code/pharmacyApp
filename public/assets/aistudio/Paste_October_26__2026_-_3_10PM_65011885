  <script>
    // 1. Supabase Initialization
    const SUPABASE_URL = "https://afzorhftbztxmwtgdpza.supabase.co";
    const SUPABASE_PUBLISHABLE_KEY = "sb_publishable_6bdfxLjp5yhsCIVFeD-aLw_VC_SvcBe";
    const client = supabase.createClient(SUPABASE_URL, SUPABASE_PUBLISHABLE_KEY);

    // Dimension Memory Cache
    let drugs = [];
    let patients = [];
    let prescribers = [];
    let pharmacies = [];
    let prescriptions = [];

    // Chart instances
    let demandChartInstance = null;
    let financialChartInstance = null;
    let drugShareChartInstance = null;
    let simForecastChartInstance = null;

    function setDemandChartWindow(min, max) {
      if (!demandChartInstance) return;

      const pointCount = demandChartInstance.data.labels.length;
      if (pointCount === 0) return;

      const visibleCount = Math.min(pointCount, Math.max(2, max - min + 1));
      const boundedMin = Math.max(0, Math.min(pointCount - visibleCount, min));
      const boundedMax = boundedMin + visibleCount - 1;

      demandChartInstance.options.scales.x.min = boundedMin;
      demandChartInstance.options.scales.x.max = boundedMax;
      demandChartInstance.update('none');

      const status = document.getElementById('demandZoomStatus');
      status.textContent = `${visibleCount} of ${pointCount} dates`;
      document.getElementById('demandPanLeft').disabled = boundedMin === 0;
      document.getElementById('demandPanRight').disabled = boundedMax === pointCount - 1;
    }

    function zoomDemandChart(direction) {
      if (!demandChartInstance) return;

      const pointCount = demandChartInstance.data.labels.length;
      const currentMin = demandChartInstance.scales.x.min;
      const currentMax = demandChartInstance.scales.x.max;
      const currentCount = currentMax - currentMin + 1;
      const nextCount = direction > 0
        ? Math.max(2, Math.floor(currentCount / 1.5))
        : Math.min(pointCount, Math.ceil(currentCount * 1.5));
      const center = (currentMin + currentMax) / 2;
      const nextMin = Math.round(center - (nextCount - 1) / 2);

      setDemandChartWindow(nextMin, nextMin + nextCount - 1);
    }

    function panDemandChart(direction) {
      if (!demandChartInstance) return;

      const currentMin = demandChartInstance.scales.x.min;
      const currentMax = demandChartInstance.scales.x.max;
      const shift = Math.max(1, Math.round((currentMax - currentMin + 1) * 0.6)) * direction;
      setDemandChartWindow(currentMin + shift, currentMax + shift);
    }

    function resetDemandChartZoom() {
      if (!demandChartInstance) return;

      const xScale = demandChartInstance.options.scales.x;
      delete xScale.min;
      delete xScale.max;
      demandChartInstance.update('none');
      document.getElementById('demandZoomStatus').textContent = `${demandChartInstance.data.labels.length} of ${demandChartInstance.data.labels.length} dates`;
      document.getElementById('demandPanLeft').disabled = true;
      document.getElementById('demandPanRight').disabled = true;
    }

    function setFinancialChartWindow(min, max) {
      if (!financialChartInstance) return;

      const pointCount = financialChartInstance.data.labels.length;
      if (pointCount === 0) return;

      const visibleCount = Math.min(pointCount, Math.max(2, max - min + 1));
      const boundedMin = Math.max(0, Math.min(pointCount - visibleCount, min));
      const boundedMax = boundedMin + visibleCount - 1;

      financialChartInstance.options.scales.x.min = boundedMin;
      financialChartInstance.options.scales.x.max = boundedMax;
      financialChartInstance.update('none');

      document.getElementById('financialZoomStatus').textContent = `${visibleCount} of ${pointCount} dates`;
      document.getElementById('financialPanLeft').disabled = boundedMin === 0;
      document.getElementById('financialPanRight').disabled = boundedMax === pointCount - 1;
    }

    function zoomFinancialChart(direction) {
      if (!financialChartInstance) return;

      const pointCount = financialChartInstance.data.labels.length;
      const currentMin = financialChartInstance.scales.x.min;
      const currentMax = financialChartInstance.scales.x.max;
      const currentCount = currentMax - currentMin + 1;
      const nextCount = direction > 0
        ? Math.max(2, Math.floor(currentCount / 1.5))
        : Math.min(pointCount, Math.ceil(currentCount * 1.5));
      const center = (currentMin + currentMax) / 2;
      const nextMin = Math.round(center - (nextCount - 1) / 2);

      setFinancialChartWindow(nextMin, nextMin + nextCount - 1);
    }

    function panFinancialChart(direction) {
      if (!financialChartInstance) return;

      const currentMin = financialChartInstance.scales.x.min;
      const currentMax = financialChartInstance.scales.x.max;
      const shift = Math.max(1, Math.round((currentMax - currentMin + 1) * 0.6)) * direction;
      setFinancialChartWindow(currentMin + shift, currentMax + shift);
    }

    function resetFinancialChartZoom() {
      if (!financialChartInstance) return;

      const xScale = financialChartInstance.options.scales.x;
      delete xScale.min;
      delete xScale.max;
      financialChartInstance.update('none');
      const pointCount = financialChartInstance.data.labels.length;
      document.getElementById('financialZoomStatus').textContent = `${pointCount} of ${pointCount} dates`;
      document.getElementById('financialPanLeft').disabled = true;
      document.getElementById('financialPanRight').disabled = true;
    }

    // 2. Lifecycle
    window.addEventListener('DOMContentLoaded', async () => {
      await loadDimensions();
      await loadPrescriptions();
      renderAnalytics();
    });

    async function loadDimensions() {
      try {
        const [drugRes, patRes, docRes, pharmRes] = await Promise.all([
          client.from('dim_drug').select('*').order('drug_name'),
          client.from('dim_patient').select('*').order('last_name'),
          client.from('dim_prescriber').select('*').order('last_name'),
          client.from('dim_pharmacy').select('*').order('branch_name')
        ]);

        drugs = drugRes.data || [];
        patients = patRes.data || [];
        prescribers = docRes.data || [];
        pharmacies = pharmRes.data || [];

        renderDrugTable(drugs);
        renderPatientTable(patients);
        renderPrescriberTable(prescribers);
        populateDropdowns();
        populateSimDrugs();

        document.getElementById('statDrugCount').innerText = drugs.length;
      } catch (err) {
        console.error("Error loading dimensional data:", err);
      }
    }

    async function loadPrescriptions() {
      try {
        const { data, error } = await client
          .from('fact_prescription')
          .select(`
            prescription_fact_id,
            quantity_dispensed,
            days_supply,
            total_amount,
            insurance_covered,
            total_cost,
            pharmacy_id,
            prescriber_id,
            drug_id,
            patient_id,
            date_id,
            dim_drug (drug_name, brand_name, dosage_form, strength),
            dim_patient (first_name, last_name, dob, gender),
            dim_prescriber (first_name, last_name, specialty),
            dim_pharmacy (branch_name, store_number),
            dim_date (full_date)
          `)
          .order('prescription_fact_id', { ascending: false });

        if (error) throw error;
        prescriptions = data || [];
        renderPrescriptions(prescriptions);
        calculateFactMetrics(prescriptions);
      } catch (err) {
        console.error("Error loading fact_prescription:", err);
      }
    }

    function calculateFactMetrics(data) {
      document.getElementById('statTotalRx').innerText = data.length;
    }

    // 3. PREDICTIVE ANALYTICS ENGINE (Linear Regression & Trend Extrapolation)
    function renderAnalytics() {
      if (prescriptions.length === 0) {
        // If empty, show placeholder metrics
        document.getElementById('statForecastUnits').innerText = "0 units";
        document.getElementById('statForecastCost').innerText = "₱0.00";
        return;
      }

      // Group prescription facts by chronological date
      const dateMap = {};
      prescriptions.forEach(p => {
        const dStr = p.dim_date?.full_date || '2026-10-01';
        if (!dateMap[dStr]) {
          dateMap[dStr] = { units: 0, billed: 0, cost: 0, insurance: 0 };
        }
        dateMap[dStr].units += Number(p.quantity_dispensed || 0);
        dateMap[dStr].billed += Number(p.total_amount || 0);
        dateMap[dStr].cost += Number(p.total_cost || 0);
        dateMap[dStr].insurance += Number(p.insurance_covered || 0);
      });

      const sortedDates = Object.keys(dateMap).sort();
      let xVals = [];
      let yUnits = [];
      let yBilled = [];

      sortedDates.forEach((d, idx) => {
        xVals.push(idx);
        yUnits.push(dateMap[d].units);
        yBilled.push(dateMap[d].billed);
      });

      // Simple Linear Regression algorithm: y = mx + b
      function linearRegression(x, y) {
        const n = x.length;
        if (n <= 1) return { slope: 0, intercept: y[0] || 0 };
        const sumX = x.reduce((a, b) => a + b, 0);
        const sumY = y.reduce((a, b) => a + b, 0);
        const sumXY = x.reduce((acc, curr, i) => acc + (curr * y[i]), 0);
        const sumXX = x.reduce((acc, curr) => acc + (curr * curr), 0);
        const slope = (n * sumXY - sumX * sumY) / (n * sumXX - sumX * sumX || 1);
        const intercept = (sumY - slope * sumX) / n;
        return { slope, intercept };
      }

      const unitRegression = linearRegression(xVals, yUnits);
      const billedRegression = linearRegression(xVals, yBilled);

      // Build 30-day forecast projection
      const futurePeriods = 3; // Forward points
      const futureLabels = [...sortedDates];
      const historicalUnitData = [...yUnits];
      const forecastedUnitData = new Array(yUnits.length - 1).fill(null);
      forecastedUnitData.push(yUnits[yUnits.length - 1]); // anchor to last real point

      for (let i = 1; i <= futurePeriods; i++) {
        const nextX = xVals.length - 1 + i;
        const nextDate = new Date(sortedDates[sortedDates.length - 1] || new Date());
        nextDate.setDate(nextDate.getDate() + (i * 10));
        futureLabels.push(nextDate.toISOString().split('T')[0] + ' (Forecast)');
        
        const predictedVal = Math.max(0, Math.round(unitRegression.slope * nextX + unitRegression.intercept));
        forecastedUnitData.push(predictedVal);
      }

      // Update KPI Badges with predictions
      const avgUnits = yUnits.reduce((a, b) => a + b, 0) / (yUnits.length || 1);
      const projected30DayUnits = Math.round(avgUnits * 30);
      const avgCostPerUnit = (yBilled.reduce((a, b) => a + b, 0) / (yUnits.reduce((a, b) => a + b, 0) || 1)) || 10;
      const projected30DayCost = projected30DayUnits * avgCostPerUnit;

      document.getElementById('statForecastUnits').innerText = `~${projected30DayUnits.toLocaleString()} units`;
      document.getElementById('statForecastCost').innerText = `₱${projected30DayCost.toLocaleString(undefined, { maximumFractionDigits: 2 })}`;

      // Render Chart 1: Demand & Prediction Line
      const ctx1 = document.getElementById('demandForecastChart').getContext('2d');
      if (demandChartInstance) demandChartInstance.destroy();
      demandChartInstance = new Chart(ctx1, {
        type: 'line',
        data: {
          labels: futureLabels,
          datasets: [
            {
              label: 'Actual Dispensed Units',
              data: [...historicalUnitData, ...new Array(futurePeriods).fill(null)],
              borderColor: '#0b2545',
              backgroundColor: 'rgba(11, 37, 69, 0.1)',
              fill: true,
              tension: 0.3,
              pointRadius: 4
            },
            {
              label: 'Regression Projection Trend',
              data: forecastedUnitData,
              borderColor: '#f59e0b',
              borderDash: [6, 6],
              backgroundColor: 'rgba(245, 158, 11, 0.1)',
              fill: true,
              tension: 0.3,
              pointRadius: 5
            }
          ]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: { legend: { position: 'top', labels: { boxWidth: 12, font: { size: 10 } } } },
          scales: { x: { min: 0, max: futureLabels.length - 1 }, y: { beginAtZero: true } }
