    function filterPrescriptions() {
      const q = document.getElementById('rxSearchInput').value.toLowerCase();
      const filtered = prescriptions.filter(rx => {
        const patName = `${rx.dim_patient?.first_name || ''} ${rx.dim_patient?.last_name || ''}`.toLowerCase();
        const drugName = (rx.dim_drug?.drug_name || '').toLowerCase();
        const docName = `${rx.dim_prescriber?.first_name || ''} ${rx.dim_prescriber?.last_name || ''}`.toLowerCase();
        const rxId = String(rx.prescription_fact_id);
        return patName.includes(q) || drugName.includes(q) || docName.includes(q) || rxId.includes(q);
      });
      renderPrescriptions(filtered);
    }

    // 6. Dispense Action & Automated dim_date Resolution
    async function handleDispensePrescription(e) {
      e.preventDefault();

      const patient_id = parseInt(document.getElementById('dispPatientId').value);
      const prescriber_id = parseInt(document.getElementById('dispPrescriberId').value);
      const drug_id = parseInt(document.getElementById('dispDrugId').value);
      const pharmacy_id = parseInt(document.getElementById('dispPharmacyId').value);
      const quantity_dispensed = parseInt(document.getElementById('dispQuantity').value);
      const days_supply = parseInt(document.getElementById('dispDaysSupply').value);
      const total_amount = parseFloat(document.getElementById('dispTotalAmount').value) || 0;
      const insurance_covered = parseFloat(document.getElementById('dispInsurance').value) || 0;
      const total_cost = Math.max(0, total_amount - insurance_covered);

      try {
        const todayObj = new Date();
        const todayIso = todayObj.toISOString().split('T')[0];

        let { data: dateRows } = await client.from('dim_date').select('date_id').eq('full_date', todayIso);
        let date_id;

        if (dateRows && dateRows.length > 0) {
          date_id = dateRows[0].date_id;
        } else {
          const daysOfWeek = ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'];
          const { data: insertedDate, error: dateErr } = await client.from('dim_date').insert([{
            full_date: todayIso,
            day_of_week: daysOfWeek[todayObj.getDay()],
            month: todayObj.getMonth() + 1,
            quarter: Math.floor(todayObj.getMonth() / 3) + 1,
            year: todayObj.getFullYear()
          }]).select('date_id').single();

          if (dateErr) throw dateErr;
          date_id = insertedDate.date_id;
        }

        const { error: factErr } = await client.from('fact_prescription').insert([{
          pharmacy_id,
          prescriber_id,
          drug_id,
          patient_id,
          date_id,
          quantity_dispensed,
          days_supply,
          total_amount,
          insurance_covered,
          total_cost
        }]);

        if (factErr) throw factErr;

        closeModal('dispenseModal');
        Swal.fire('Dispensed Successfully', 'Fact table updated.', 'success');
        await loadPrescriptions();
        renderAnalytics();
      } catch (err) {
        Swal.fire('Dispense Failed', err.message, 'error');
      }
    }

    function calcCost() {
      const amt = parseFloat(document.getElementById('dispTotalAmount').value) || 0;
      const ins = parseFloat(document.getElementById('dispInsurance').value) || 0;
      const cost = Math.max(0, amt - ins);
      document.getElementById('dispTotalCostPreview').innerText = `₱${cost.toFixed(2)}`;
    }

