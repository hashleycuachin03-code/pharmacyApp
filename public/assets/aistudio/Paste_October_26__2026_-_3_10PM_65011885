      const topDrugValues = topDrugs.length > 0 ? topDrugs.map(([, units]) => units) : [0];

      const ctx3 = document.getElementById('drugShareChart').getContext('2d');
      if (drugShareChartInstance) drugShareChartInstance.destroy();
      drugShareChartInstance = new Chart(ctx3, {
        type: 'bar',
        data: {
          labels: topDrugLabels,
          datasets: [{
            label: 'Units dispensed',
            data: topDrugValues,
            backgroundColor: '#0b2545',
            hoverBackgroundColor: '#f59e0b',
            borderRadius: 3,
            barThickness: 18
          }]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          indexAxis: 'y',
          scales: {
            x: { beginAtZero: true, title: { display: true, text: 'Units dispensed' }, ticks: { precision: 0 } },
            y: { reverse: true, ticks: { autoSkip: false, font: { size: 10 } } }
          },
          plugins: {
            legend: { display: false },
            tooltip: {
              callbacks: {
                label: context => `${Number(context.raw).toLocaleString()} units dispensed`
