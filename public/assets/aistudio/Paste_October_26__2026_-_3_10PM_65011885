<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>BUPC Pharmacy | Predictive Analytics & Management Portal</title>

  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- Supabase JS Client -->
  <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
  <!-- Chart.js for Visual Analytics & Predictions -->
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
  <!-- FontAwesome Icons -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
  <!-- SweetAlert2 -->
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

  <style>
    @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap');
    body { font-family: 'Plus Jakarta Sans', sans-serif; }
    @media print {
      body * { visibility: hidden; }
      #printableSlip, #printableSlip * { visibility: visible; }
      #printableSlip { position: absolute; left: 0; top: 0; width: 100%; display: block !important; }
    }
  </style>
</head>
<body class="bg-slate-100 text-slate-800 min-h-screen flex flex-col antialiased">

  <!-- Header -->
  <header class="bg-[#0b2545] text-white border-b-4 border-amber-500 sticky top-0 z-40 shadow-md">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
      <div class="flex items-center space-x-3">
        <div class="w-10 h-10 rounded-lg bg-amber-500 text-[#0b2545] flex items-center justify-center font-black text-xl shadow">
          <i class="fa-solid fa-chart-line"></i>
        </div>
        <div>
          <h1 class="font-extrabold text-sm sm:text-base tracking-wide uppercase text-white flex items-center gap-2">
            BUPC PHARMACY INFIRMARY
            <span class="bg-amber-400 text-slate-950 text-[10px] font-black px-2 py-0.5 rounded uppercase">AI & DW</span>
          </h1>
          <p class="text-xs text-slate-300">Bicol University Polangui Campus</p>
        </div>
      </div>

      <!-- Navigation Tabs -->
      <nav class="flex items-center space-x-1 sm:space-x-2">
        <button onclick="switchTab('analytics')" id="btn-tab-analytics" class="tab-btn px-3 py-1.5 rounded-lg text-xs font-bold bg-amber-500 text-slate-900 transition flex items-center gap-1.5">
          <i class="fa-solid fa-brain"></i> <span class="hidden sm:inline">Predictive Analytics</span>
        </button>
        <button onclick="switchTab('prescriptions')" id="btn-tab-prescriptions" class="tab-btn px-3 py-1.5 rounded-lg text-xs font-semibold text-slate-300 hover:bg-slate-800 transition flex items-center gap-1.5">
          <i class="fa-solid fa-file-prescription"></i> <span class="hidden sm:inline">Prescription Desk</span>
        </button>
        <button onclick="switchTab('drugs')" id="btn-tab-drugs" class="tab-btn px-3 py-1.5 rounded-lg text-xs font-semibold text-slate-300 hover:bg-slate-800 transition flex items-center gap-1.5">
          <i class="fa-solid fa-pills"></i> <span class="hidden sm:inline">Drug Formulary</span>
        </button>
        <button onclick="switchTab('patients')" id="btn-tab-patients" class="tab-btn px-3 py-1.5 rounded-lg text-xs font-semibold text-slate-300 hover:bg-slate-800 transition flex items-center gap-1.5">
          <i class="fa-solid fa-hospital-user"></i> <span class="hidden sm:inline">Patients</span>
        </button>
        <button onclick="switchTab('prescribers')" id="btn-tab-prescribers" class="tab-btn px-3 py-1.5 rounded-lg text-xs font-semibold text-slate-300 hover:bg-slate-800 transition flex items-center gap-1.5">
          <i class="fa-solid fa-user-doctor"></i> <span class="hidden sm:inline">Prescribers</span>
        </button>
      </nav>
    </div>
  </header>

  <!-- Metric KPI Bar -->
  <section class="bg-white border-b border-slate-200 py-3 shadow-sm">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 grid grid-cols-2 md:grid-cols-4 gap-4">
      <div class="flex items-center space-x-3">
        <div class="p-2.5 bg-blue-50 text-blue-700 rounded-lg"><i class="fa-solid fa-file-medical text-lg"></i></div>
        <div>
          <p class="text-[11px] font-semibold uppercase text-slate-500">Total Rx Recorded</p>
          <h4 id="statTotalRx" class="text-xl font-bold text-slate-900 leading-tight">0</h4>
        </div>
      </div>
      <div class="flex items-center space-x-3">
        <div class="p-2.5 bg-amber-50 text-amber-700 rounded-lg"><i class="fa-solid fa-arrow-trend-up text-lg"></i></div>
        <div>
          <p class="text-[11px] font-semibold uppercase text-slate-500">Projected 30-Day Demand</p>
          <h4 id="statForecastUnits" class="text-xl font-bold text-amber-600 leading-tight">-- units</h4>
        </div>
      </div>
      <div class="flex items-center space-x-3">
        <div class="p-2.5 bg-emerald-50 text-emerald-700 rounded-lg"><i class="fa-solid fa-sack-dollar text-lg"></i></div>
        <div>
          <p class="text-[11px] font-semibold uppercase text-slate-500">Projected 30-Day Budget</p>
          <h4 id="statForecastCost" class="text-xl font-bold text-emerald-700 leading-tight">₱0.00</h4>
        </div>
      </div>
      <div class="flex items-center space-x-3">
        <div class="p-2.5 bg-purple-50 text-purple-700 rounded-lg"><i class="fa-solid fa-capsules text-lg"></i></div>
        <div>
          <p class="text-[11px] font-semibold uppercase text-slate-500">Active Formulary Items</p>
          <h4 id="statDrugCount" class="text-xl font-bold text-purple-700 leading-tight">0</h4>
        </div>
      </div>
    </div>
  </section>

  <!-- Main View Area -->
  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 flex-1 w-full space-y-6">

    <!-- VIEW 0: PREDICTIVE ANALYTICS & FORECASTING -->
    <div id="tab-analytics" class="space-y-6">
      <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-2">
        <div>
          <h2 class="text-lg font-extrabold text-slate-900 flex items-center gap-2">
            <i class="fa-solid fa-crystal-ball text-amber-500"></i> BUPC Predictive Health Analytics
          </h2>
          <p class="text-xs text-slate-500">Linear regression forecasting, demand velocity, and inventory exhaustion projections</p>
        </div>
        <button onclick="renderAnalytics()" class="px-3 py-1.5 bg-white border border-slate-300 hover:bg-slate-50 text-slate-700 rounded-lg text-xs font-bold transition flex items-center gap-1.5 shadow-sm">
          <i class="fa-solid fa-arrows-rotate text-blue-600"></i> Refresh Models
        </button>
      </div>

      <!-- Charts Row 1: Demand Forecast & Financial Projection -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
        
        <!-- Left: Consumption Trend + 30-Day Prediction (7 cols) -->
        <div class="lg:col-span-7 bg-white p-5 rounded-xl border border-slate-200 shadow-sm space-y-3">
          <div class="flex justify-between items-center">
            <div>
              <h3 class="font-bold text-sm text-slate-800">Prescription Consumption Velocity & Projection</h3>
              <p class="text-[11px] text-slate-400">Historical units dispensed (solid) vs. projected regression trend (dashed)</p>
            </div>
            <div class="flex items-center gap-1.5">
              <div class="flex items-center gap-1" role="group" aria-label="Dispense trend chart controls">
                <button type="button" onclick="panDemandChart(-1)" title="Pan chart left" aria-label="Pan chart left" class="w-7 h-7 rounded border border-slate-200 text-slate-600 hover:bg-slate-100 disabled:opacity-40" id="demandPanLeft">
                  <i class="fa-solid fa-chevron-left text-[10px]"></i>
                </button>
                <button type="button" onclick="zoomDemandChart(-1)" title="Zoom out" aria-label="Zoom out" class="w-7 h-7 rounded border border-slate-200 text-slate-600 hover:bg-slate-100">
                  <i class="fa-solid fa-magnifying-glass-minus text-[10px]"></i>
                </button>
                <button type="button" onclick="zoomDemandChart(1)" title="Zoom in" aria-label="Zoom in" class="w-7 h-7 rounded border border-slate-200 text-slate-600 hover:bg-slate-100">
                  <i class="fa-solid fa-magnifying-glass-plus text-[10px]"></i>
                </button>
                <button type="button" onclick="panDemandChart(1)" title="Pan chart right" aria-label="Pan chart right" class="w-7 h-7 rounded border border-slate-200 text-slate-600 hover:bg-slate-100 disabled:opacity-40" id="demandPanRight">
                  <i class="fa-solid fa-chevron-right text-[10px]"></i>
                </button>
                <button type="button" onclick="resetDemandChartZoom()" title="Reset chart zoom" aria-label="Reset chart zoom" class="w-7 h-7 rounded border border-slate-200 text-slate-600 hover:bg-slate-100">
                  <i class="fa-solid fa-arrows-rotate text-[10px]"></i>
                </button>
              </div>
              <span id="demandZoomStatus" class="hidden sm:inline text-[10px] text-slate-400 whitespace-nowrap"></span>
              <span class="hidden xl:inline text-[11px] font-bold bg-amber-100 text-amber-800 px-2 py-0.5 rounded">Next 30-Day Outlook</span>
            </div>
          </div>
          <div class="h-64">
            <canvas id="demandForecastChart"></canvas>
          </div>
        </div>

        <!-- Right: Financial & Insurance Coverage Forecast (5 cols) -->
        <div class="lg:col-span-5 bg-white p-5 rounded-xl border border-slate-200 shadow-sm space-y-3">
          <div class="flex justify-between items-center">
            <div>
              <h3 class="font-bold text-sm text-slate-800">Financial Impact & Subsidy Projection</h3>
              <p class="text-[11px] text-slate-400">All recorded dates: patient cost vs. insurance subsidy</p>
            </div>
          </div>
          <div class="flex items-center justify-between">
            <span id="financialZoomStatus" class="text-[10px] text-slate-400"></span>
            <div class="flex items-center gap-1" role="group" aria-label="Financial chart controls">
              <button type="button" onclick="panFinancialChart(-1)" title="Pan chart left" aria-label="Pan chart left" class="w-7 h-7 rounded border border-slate-200 text-slate-600 hover:bg-slate-100 disabled:opacity-40" id="financialPanLeft">
                <i class="fa-solid fa-chevron-left text-[10px]"></i>
              </button>
              <button type="button" onclick="zoomFinancialChart(-1)" title="Zoom out" aria-label="Zoom out" class="w-7 h-7 rounded border border-slate-200 text-slate-600 hover:bg-slate-100">
                <i class="fa-solid fa-magnifying-glass-minus text-[10px]"></i>
              </button>
              <button type="button" onclick="zoomFinancialChart(1)" title="Zoom in" aria-label="Zoom in" class="w-7 h-7 rounded border border-slate-200 text-slate-600 hover:bg-slate-100">
                <i class="fa-solid fa-magnifying-glass-plus text-[10px]"></i>
              </button>
              <button type="button" onclick="panFinancialChart(1)" title="Pan chart right" aria-label="Pan chart right" class="w-7 h-7 rounded border border-slate-200 text-slate-600 hover:bg-slate-100 disabled:opacity-40" id="financialPanRight">
                <i class="fa-solid fa-chevron-right text-[10px]"></i>
              </button>
              <button type="button" onclick="resetFinancialChartZoom()" title="Reset chart zoom" aria-label="Reset chart zoom" class="w-7 h-7 rounded border border-slate-200 text-slate-600 hover:bg-slate-100">
                <i class="fa-solid fa-arrows-rotate text-[10px]"></i>
              </button>
            </div>
          </div>
          <div class="h-64">
            <canvas id="financialChart"></canvas>
          </div>
        </div>
      </div>

      <!-- Charts Row 2: Drug Breakdown & Interactive Surge Simulator -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">

        <!-- Left: Top High-Velocity Drugs (5 cols) -->
        <div class="lg:col-span-5 bg-white p-5 rounded-xl border border-slate-200 shadow-sm space-y-3">
          <h3 class="font-bold text-sm text-slate-800">Highest-Velocity Medications</h3>
          <p class="text-[11px] text-slate-400">Top 8 medications ranked by total units dispensed</p>
          <div class="h-72">
            <canvas id="drugShareChart"></canvas>
          </div>
        </div>

        <!-- Right: Campus Surge Scenario Simulator (7 cols) -->
        <div class="lg:col-span-7 bg-white p-5 rounded-xl border border-slate-200 shadow-sm flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between border-b pb-2">
              <h3 class="font-bold text-sm text-slate-800 flex items-center gap-2">
                <i class="fa-solid fa-sliders text-amber-600"></i> Campus Demand Surge Simulator
              </h3>
              <span class="text-[10px] bg-slate-100 text-slate-600 px-2 py-0.5 rounded font-bold">What-If Modeling</span>
            </div>
            <p class="text-[11px] text-slate-500 mt-2">
              Estimate procurement stock required when an influenza spike, athletic meet, or midterms surge occurs on campus.
            </p>

            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-3 mt-4">
              <div>
                <label class="block text-[11px] font-bold text-slate-600 uppercase mb-1">Target Medication</label>
                <select id="simDrugSelect" onchange="runSurgeSimulation()" class="w-full border border-slate-300 rounded p-2 text-xs bg-white font-medium">
                  <!-- dynamically filled -->
                </select>
              </div>
              <div>
                <label class="block text-[11px] font-bold text-slate-600 uppercase mb-1">Surge Factor (% Increase)</label>
                <select id="simSurgePct" onchange="runSurgeSimulation()" class="w-full border border-slate-300 rounded p-2 text-xs bg-white font-medium">
                  <option value="0">Normal Baseline (+0%)</option>
                  <option value="25">Midterm Stress / Rainy Season (+25%)</option>
                  <option value="50">Flu Outbreak / Exam Week (+50%)</option>
                  <option value="100">Intramurals / Major Campus Event (+100%)</option>
                </select>
              </div>
              <div>
                <label class="block text-[11px] font-bold text-slate-600 uppercase mb-1">Forecast Horizon</label>
                <select id="simHorizon" onchange="runSurgeSimulation()" class="w-full border border-slate-300 rounded p-2 text-xs bg-white font-medium">
                  <option value="15">Next 15 Days</option>
                  <option value="30" selected>Next 30 Days</option>
                  <option value="60">Next 60 Days</option>
                </select>
              </div>
              <div>
                <label class="block text-[11px] font-bold text-slate-600 uppercase mb-1">Baseline History</label>
                <select id="simBaselineDays" onchange="runSurgeSimulation()" class="w-full border border-slate-300 rounded p-2 text-xs bg-white font-medium">
                  <option value="30">Last 30 Days</option>
                  <option value="90">Last 90 Days</option>
                  <option value="all">All Available</option>
                </select>
              </div>
              <div>
                <label class="block text-[11px] font-bold text-slate-600 uppercase mb-1">Stock On Hand</label>
                <input type="number" id="simStockOnHand" min="0" step="1" placeholder="Enter units" oninput="runSurgeSimulation()" class="w-full border border-slate-300 rounded p-2 text-xs bg-white font-medium" />
              </div>
            </div>
          </div>

          <!-- Simulation Output Box -->
          <div class="mt-4 p-4 bg-slate-50 rounded-lg border border-slate-200 grid grid-cols-2 xl:grid-cols-4 gap-3 text-center">
            <div>
              <p class="text-[10px] uppercase font-bold text-slate-400">Baseline Daily Rate</p>
              <h5 id="simVelocityLabel" class="text-base font-extrabold text-slate-800 mt-0.5">0.0 units/day</h5>
              <p id="simBaselineCoverage" class="text-[10px] text-slate-400 mt-0.5">No history selected</p>
            </div>
            <div>
              <p class="text-[10px] uppercase font-bold text-amber-600">Forecast Demand</p>
              <h5 id="simUnitsNeededLabel" class="text-base font-extrabold text-amber-600 mt-0.5">0 units</h5>
            </div>
            <div>
              <p class="text-[10px] uppercase font-bold text-blue-700">Additional Units Needed</p>
              <h5 id="simReorderLabel" class="text-base font-extrabold text-blue-700 mt-0.5">Enter stock</h5>
              <p id="simCoverageLabel" class="text-[10px] text-slate-400 mt-0.5">Stock coverage unavailable</p>
            </div>
            <div>
              <p class="text-[10px] uppercase font-bold text-emerald-700">Estimated Billed Value</p>
              <h5 id="simBudgetLabel" class="text-base font-extrabold text-emerald-700 mt-0.5">₱0.00</h5>
            </div>
          </div>
          <p class="text-[10px] text-slate-400">Value estimate uses historical billed amount per unit, not supplier acquisition cost.</p>

          <div class="grid grid-cols-1 xl:grid-cols-2 gap-4 mt-4">
            <section>
              <h4 class="text-xs font-bold text-slate-700 mb-2">Scenario Comparison</h4>
              <div class="overflow-x-auto border border-slate-200 rounded-lg">
                <table class="w-full text-left text-[10px] text-slate-600">
                  <thead class="bg-slate-100 text-slate-700 uppercase font-bold">
                    <tr>
                      <th class="p-2">Scenario</th>
                      <th class="p-2 text-right">Demand</th>
                      <th class="p-2 text-right">Additional</th>
                      <th class="p-2 text-right">Est. Value</th>
                    </tr>
                  </thead>
                  <tbody id="simScenarioRows">
                    <tr><td colspan="4" class="p-3 text-center text-slate-400">Select a medication to compare scenarios.</td></tr>
                  </tbody>
                </table>
              </div>
            </section>
            <section>
              <h4 class="text-xs font-bold text-slate-700 mb-2">Projected Demand vs. Stock</h4>
              <div class="h-48 relative">
                <canvas id="simForecastChart" class="hidden"></canvas>
                <p id="simForecastMessage" class="absolute inset-0 flex items-center justify-center text-center text-[11px] text-slate-400">Select a medication with dated dispense records.</p>
              </div>
            </section>
          </div>
        </div>

      </div>
    </div>

    <!-- VIEW 1: PRESCRIPTIONS (FACT PRESCRIPTION & DISPENSING) -->
    <div id="tab-prescriptions" class="hidden space-y-6">
      
      <!-- Dispensing Action Bar -->
      <div class="flex flex-col sm:flex-row justify-between items-center gap-3">
        <div class="relative w-full sm:w-80">
          <i class="fa-solid fa-magnifying-glass absolute left-3 top-2.5 text-slate-400 text-xs"></i>
          <input type="text" id="rxSearchInput" oninput="filterPrescriptions()" placeholder="Search patient, drug, or doctor..." 
            class="w-full pl-9 pr-3 py-2 text-xs bg-white border border-slate-300 rounded-lg focus:ring-2 focus:ring-[#0b2545] outline-none" />
        </div>
        <button onclick="openDispenseModal()" class="w-full sm:w-auto px-4 py-2 bg-[#0b2545] hover:bg-slate-800 text-amber-400 font-bold rounded-lg text-xs flex items-center justify-center gap-2 shadow transition">
          <i class="fa-solid fa-plus-circle text-amber-400"></i>
          <span>Dispense New Prescription</span>
        </button>
      </div>

      <!-- Fact Prescription Table -->
      <div class="bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden">
        <div class="overflow-x-auto">
          <table class="w-full text-left text-xs text-slate-600">
            <thead class="bg-slate-100 text-slate-700 uppercase font-bold border-b border-slate-200">
              <tr>
                <th class="p-3.5">Rx ID</th>
                <th class="p-3.5">Date</th>
                <th class="p-3.5">Patient</th>
                <th class="p-3.5">Drug Dispensed</th>
                <th class="p-3.5">Prescriber (MD)</th>
                <th class="p-3.5 text-center">Qty / Days</th>
                <th class="p-3.5 text-right">Total Amount</th>
                <th class="p-3.5 text-right">Out-of-Pocket</th>
                <th class="p-3.5 text-center">Actions</th>
              </tr>
            </thead>
            <tbody id="prescriptionTableBody" class="divide-y divide-slate-100 font-medium">
              <tr>
                <td colspan="9" class="p-6 text-center text-slate-400">Loading prescription facts from Supabase...</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <!-- VIEW 2: DIM_DRUG (FORMULARY) -->
    <div id="tab-drugs" class="hidden space-y-4">
      <div class="flex justify-between items-center gap-3">
        <h3 class="text-sm font-bold text-slate-800">Drug Formulary (`dim_drug`)</h3>
        <button onclick="openAddDrugModal()" class="px-3.5 py-2 bg-[#0b2545] text-white rounded-lg text-xs font-bold hover:bg-slate-800 transition flex items-center gap-1.5">
          <i class="fa-solid fa-plus text-amber-400"></i> Add New Drug
        </button>
      </div>

      <div class="bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden">
        <table class="w-full text-left text-xs text-slate-600">
          <thead class="bg-slate-100 text-slate-700 uppercase font-bold border-b border-slate-200">
            <tr>
              <th class="p-3.5">Drug ID</th>
              <th class="p-3.5">Drug Name</th>
              <th class="p-3.5">Brand Name</th>
              <th class="p-3.5">Generic Name</th>
              <th class="p-3.5">Dosage Form</th>
              <th class="p-3.5">Strength</th>
            </tr>
          </thead>
          <tbody id="drugTableBody" class="divide-y divide-slate-100 font-medium">
            <tr><td colspan="6" class="p-6 text-center text-slate-400">Loading drugs...</td></tr>
          </tbody>
        </table>
      </div>
    </div>

    <!-- VIEW 3: DIM_PATIENT -->
    <div id="tab-patients" class="hidden space-y-4">
      <div class="flex justify-between items-center gap-3">
        <h3 class="text-sm font-bold text-slate-800">Patient Directory (`dim_patient`)</h3>
        <button onclick="openAddPatientModal()" class="px-3.5 py-2 bg-[#0b2545] text-white rounded-lg text-xs font-bold hover:bg-slate-800 transition flex items-center gap-1.5">
          <i class="fa-solid fa-user-plus text-amber-400"></i> Add New Patient
        </button>
      </div>

      <div class="bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden">
        <table class="w-full text-left text-xs text-slate-600">
          <thead class="bg-slate-100 text-slate-700 uppercase font-bold border-b border-slate-200">
            <tr>
              <th class="p-3.5">Patient ID</th>
              <th class="p-3.5">Full Name</th>
              <th class="p-3.5">Date of Birth</th>
              <th class="p-3.5">Gender</th>
              <th class="p-3.5">Address</th>
            </tr>
          </thead>
          <tbody id="patientTableBody" class="divide-y divide-slate-100 font-medium">
            <tr><td colspan="5" class="p-6 text-center text-slate-400">Loading patients...</td></tr>
          </tbody>
        </table>
      </div>
    </div>

    <!-- VIEW 4: DIM_PRESCRIBER -->
    <div id="tab-prescribers" class="hidden space-y-4">
      <div class="flex justify-between items-center gap-3">
        <h3 class="text-sm font-bold text-slate-800">Prescribing Clinicians (`dim_prescriber`)</h3>
        <button onclick="openAddPrescriberModal()" class="px-3.5 py-2 bg-[#0b2545] text-white rounded-lg text-xs font-bold hover:bg-slate-800 transition flex items-center gap-1.5">
          <i class="fa-solid fa-user-md text-amber-400"></i> Add Prescriber
        </button>
      </div>

      <div class="bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden">
