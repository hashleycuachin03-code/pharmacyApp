      financialChartInstance = new Chart(ctx2, {
        type: 'bar',
        data: {
          labels: sortedDates,
          datasets: [
            {
              label: 'Patient Out-of-Pocket',
              data: sortedDates.map(d => dateMap[d].cost),
              backgroundColor: '#10b981'
            },
            {
              label: 'Insurance Covered',
              data: sortedDates.map(d => dateMap[d].insurance),
              backgroundColor: '#f59e0b'
            }
          ]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          scales: {
            x: { stacked: true, min: 0, max: sortedDates.length - 1, ticks: { autoSkip: true, maxTicksLimit: 6, maxRotation: 0 } },
            y: { stacked: true, beginAtZero: true }
          },
          plugins: { legend: { position: 'top', labels: { boxWidth: 12, font: { size: 10 } } } }
        }
      });
      resetFinancialChartZoom();

      // Render Chart 3: Drug Consumption Distribution
      const drugTotals = {};
      prescriptions.forEach(p => {
        const name = p.dim_drug?.drug_name || 'Other';
        drugTotals[name] = (drugTotals[name] || 0) + Number(p.quantity_dispensed || 0);
